<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme. Same key set as Controls/1_Colors.xaml and 0_LightColors.xaml; swapped at runtime by ThemeManager. -->

    <Color x:Key="SurfaceColor">#15171C</Color>
    <Color x:Key="SurfaceRaisedColor">#1E2128</Color>
    <Color x:Key="SurfaceSunkenColor">#101216</Color>
    <Color x:Key="BackdropStartColor">#06152B</Color>
    <Color x:Key="BackdropMidColor">#102A4B</Color>
    <Color x:Key="BackdropEndColor">#08111F</Color>
    <Color x:Key="GlassSurfaceColor">#8813233A</Color>
    <Color x:Key="GlassRaisedColor">#B81E3049</Color>
    <Color x:Key="GlassStrokeColor">#5AABC8E8</Color>
    <Color x:Key="AmbientBlueColor">#A0357DE8</Color>
    <Color x:Key="AmbientCyanColor">#7031C8D5</Color>
    <Color x:Key="AmbientVioletColor">#666A5BE7</Color>
    <Color x:Key="ShadowColor">#78000000</Color>
    <Color x:Key="StrokeColor">#2B3038</Color>
    <Color x:Key="StrokeStrongColor">#3B414B</Color>
    <Color x:Key="TextPrimaryColor">#E7E9EC</Color>
    <Color x:Key="TextSecondaryColor">#9AA2AD</Color>
    <Color x:Key="TextDisabledColor">#5D6570</Color>
    <Color x:Key="AccentColor">#F06767</Color>
    <Color x:Key="AccentHoverColor">#F58282</Color>
    <Color x:Key="AccentPressedColor">#D95252</Color>
    <Color x:Key="AccentSoftColor">#3D2427</Color>
    <Color x:Key="AccentForegroundColor">#15171C</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessTextColor">#34D399</Color>
    <Color x:Key="WarningColor">#F5B451</Color>
    <Color x:Key="DangerColor">#F26D67</Color>
    <Color x:Key="ControlColor">#22262E</Color>
    <Color x:Key="ControlHoverColor">#2A2F38</Color>
    <Color x:Key="ControlPressedColor">#333944</Color>
    <Color x:Key="ControlDisabledColor">#1B1E24</Color>
    <Color x:Key="ScrollThumbColor">#3B414B</Color>
    <Color x:Key="ScrollThumbHoverColor">#4B525D</Color>
    <Color x:Key="ScrollThumbActiveColor">#5D6570</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}"/>
    <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackdropStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BackdropMidColor}" Offset="0.52"/>
        <GradientStop Color="{StaticResource BackdropEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource GlassSurfaceColor}"/>
    <SolidColorBrush x:Key="GlassRaisedBrush" Color="{StaticResource GlassRaisedColor}"/>
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{StaticResource GlassStrokeColor}"/>
    <SolidColorBrush x:Key="AmbientBlueBrush" Color="{StaticResource AmbientBlueColor}"/>
    <SolidColorBrush x:Key="AmbientCyanBrush" Color="{StaticResource AmbientCyanColor}"/>
    <SolidColorBrush x:Key="AmbientVioletBrush" Color="{StaticResource AmbientVioletColor}"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="{StaticResource ControlDisabledColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{StaticResource ScrollThumbActiveColor}"/>

    <!-- Legacy keys -->
    <Color x:Key="ActiveColor">#34D399</Color>
    <Color x:Key="ControlMouseOverColor">#F58282</Color>
    <Color x:Key="WindowColor">#15171C</Color>
    <Color x:Key="SelectedBackgroundColor">#3D2427</Color>
    <Color x:Key="SelectedUnfocusedColor">#333944</Color>
    <Color x:Key="ControlLightColor">#22262E</Color>
    <Color x:Key="ControlMediumColor">#3B414B</Color>
    <Color x:Key="IconBackgroundColor">#101216</Color>
    <Color x:Key="GlyphColor">#9AA2AD</Color>
    <Color x:Key="DisabledForegroundColor">#5D6570</Color>
    <Color x:Key="DisabledControlDarkColor">#1B1E24</Color>
    <Color x:Key="DisabledBorderColor">#2B3038</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ActiveBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="HighlightedBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="HighlightedInactiveAccentBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="MouseOverBrush" Color="{StaticResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlLightBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="{StaticResource SurfaceSunkenColor}"/>
    <SolidColorBrush x:Key="InactiveAccentBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="DisabledAccentBrush" Color="{StaticResource ControlDisabledColor}"/>
    <SolidColorBrush x:Key="DragScrollBrush" Color="{StaticResource ScrollThumbActiveColor}"/>
    <SolidColorBrush x:Key="ScrollBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="MouseOverScrollBrush" Color="{StaticResource ScrollThumbHoverColor}"/>

</ResourceDictionary>
