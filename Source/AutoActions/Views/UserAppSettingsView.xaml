<UserControl x:Class="AutoActions.Views.UserAppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:AutoActions.Views"
             xmlns:root="clr-namespace:AutoActions"
             xmlns:pres="clr-namespace:AutoActions.ProjectResources;assembly=AutoActions.ProjectResources"
             xmlns:thm="clr-namespace:AutoActions.Theming"
             d:DataContext="{d:DesignInstance root:UserAppSettings, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" MinHeight="200" MinWidth="229.498" >


    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Style="{StaticResource SubTitleTextBlock}" Grid.Column="0"  Grid.Row="0"   Text="{x:Static pres:ProjectLocales.Settings}"/>
        <TextBlock Style="{StaticResource SubTitleTextBlock}" Grid.Column="1"  Grid.Row="0"   Text="{x:Static pres:ProjectLocales.ActionShortcuts}"></TextBlock>

        <Border Style="{StaticResource DefaultBorder}" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <Grid    Width="Auto" Height="Auto">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- The upstream update options (CheckForNewVersion, AutoUpdate, HideSplashScreenOnAutoUpdate) are gone with the updater;
                     the settings properties still exist so old settings files load. -->
                <TextBlock Style="{StaticResource DefaultTextBlock}"    Text="{x:Static pres:ProjectLocales.AutoStart}" Grid.Column="0" Grid.Row="0" Margin="10,4,10,2"  VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}"   Text="{x:Static pres:ProjectLocales.StartToTray}"  Grid.Column="0" Grid.Row="1" Margin="10,3,2,3"  VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}"   Text="{x:Static pres:ProjectLocales.MinimizeToTray}"  Grid.Column="0" Grid.Row="2" Margin="10,3,2,3"  VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}"   Text="{x:Static pres:ProjectLocales.CreateLogFile}"  Grid.Column="0" Grid.Row="3" Margin="10,3,2,3"  VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}"   Text="{x:Static pres:ProjectLocales.HideSplashScreenOnStartup}"  Grid.Column="0" Grid.Row="4" Margin="10,3,3,3"  VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}"   Text="{x:Static pres:ProjectLocales.GlobalAutoHDR}"  Grid.Column="0" Grid.Row="5" Margin="10,3,3,3" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                <TextBlock  Style="{StaticResource DefaultTextBlock}"  Text="{x:Static pres:ProjectLocales.DefaultProfile}"  Grid.Column="0" Grid.Row="6" Margin="10,3,3,3" HorizontalAlignment="Left"  VerticalAlignment="Center"/>

                <CheckBox  IsChecked="{Binding AutoStart}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <CheckBox  IsChecked="{Binding StartMinimizedToTray}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <CheckBox  IsChecked="{Binding CloseToTray}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <CheckBox  IsChecked="{Binding CreateLogFile}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <CheckBox  IsChecked="{Binding HideSplashScreenOnStartup}" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <CheckBox IsChecked="{Binding GlobalAutoActions}" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="1" Grid.Row="6" MaxWidth="250"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" SelectedValuePath="Name" DisplayMemberPath="Name" SelectedValue="{Binding DefaultProfile, Mode=TwoWay}" SelectedItem="{Binding DefaultProfile, Mode=TwoWay}" ItemsSource="{Binding ApplicationProfiles}"  />

                <TextBlock Style="{StaticResource SubTitleTextBlock}" Text="{x:Static pres:ProjectLocales.MicMonitoring}" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="3" Margin="5,15,3,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.MicMonitoringDevice}" Grid.Column="0" Grid.Row="8" Margin="10,3,3,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Grid.Row="8" Grid.ColumnSpan="2" MinWidth="250" MaxWidth="400" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" DisplayMemberPath="Name" ItemsSource="{Binding MicMonitoringEndpoints}" SelectedItem="{Binding MicMonitoringEndpoint, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.MicMonitoringLine}" Grid.Column="0" Grid.Row="9" Margin="10,3,3,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Grid.Row="9" Grid.ColumnSpan="2" MinWidth="250" MaxWidth="400" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" DisplayMemberPath="Description" ItemsSource="{Binding MicMonitoringLines}" SelectedItem="{Binding MicMonitoringLine, Mode=TwoWay}"/>

                <TextBlock Style="{StaticResource SubTitleTextBlock}" Text="{x:Static pres:ProjectLocales.Appearance}" Grid.Column="0" Grid.Row="10" Grid.ColumnSpan="3" Margin="5,15,3,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.Theme}" Grid.Column="0" Grid.Row="11" Margin="10,3,3,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Grid.Row="11" Grid.ColumnSpan="2" MinWidth="180" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Static pres:ProjectLocales.ThemeSystem}" Tag="{x:Static thm:ThemeSetting.System}"/>
                    <ComboBoxItem Content="{x:Static pres:ProjectLocales.ThemeLight}" Tag="{x:Static thm:ThemeSetting.Light}"/>
                    <ComboBoxItem Content="{x:Static pres:ProjectLocales.ThemeDark}" Tag="{x:Static thm:ThemeSetting.Dark}"/>
                </ComboBox>

            </Grid>
        </ScrollViewer>
        <local:ActionShortcutManagerView Grid.Row="1"  Grid.Column="1" />

    </Grid>
</UserControl>
