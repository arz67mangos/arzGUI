<UserControl x:Name="StatusViewControl"  x:Class="AutoActions.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:corewpf="clr-namespace:CodectoryCore.UI.Wpf;assembly=CodectoryCore.UI.Wpf"
             xmlns:local="clr-namespace:AutoActions.Views"
             xmlns:root="clr-namespace:AutoActions"
             xmlns:pres="clr-namespace:AutoActions.ProjectResources;assembly=AutoActions.ProjectResources"
             d:DataContext="{d:DesignInstance root:AutoActionsDaemon, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" MinHeight="200" MinWidth="229.498">

    <UserControl.Resources>
        <!-- count == 0 -> Visible (for empty states) -->
        <corewpf:ConverterChain x:Key="ZeroVisibilityConverter">
            <corewpf:IsNotZeroConverter/>
            <corewpf:InvertBooleanConverter/>
            <corewpf:VisibilityBooleanConverter/>
        </corewpf:ConverterChain>

        <Style x:Key="HdrStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlock}">
            <Setter Property="Text" Value="{x:Static pres:ProjectLocales.Off}"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HDRIsActive}" Value="True">
                    <Setter Property="Text" Value="{x:Static pres:ProjectLocales.On}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- An action shortcut row: name + run -->
        <DataTemplate x:Key="ActionShortcutItemTemplate" DataType="ProfileActionShortcut">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DefaultTextBlock}" Grid.Column="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShortcutName}" Text="{Binding ShortcutName}" Margin="8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" ToolTip="{Binding ShortcutName}" Command="{Binding RunActionCommand}"/>
            </Grid>
        </DataTemplate>

        <!-- An assigned application row: icon, name, launch -->
        <DataTemplate x:Key="ApplicationTemplate" DataType="ApplicationProfileAssignment">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" Style="{StaticResource WellBorder}">
                    <Border Width="30" Height="30" CornerRadius="{StaticResource SmallCornerRadius}">
                        <Border.Background>
                            <ImageBrush Stretch="Uniform" ImageSource="{Binding Application.Icon, Converter={StaticResource BitmapToBitmapImageConverter}}"/>
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Style="{StaticResource DefaultTextBlock}" Text="{Binding Application.DisplayName}" ToolTip="{Binding Application.DisplayName}" TextTrimming="CharacterEllipsis" Margin="0"/>
                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding Profile.Name, FallbackValue={x:Static pres:ProjectLocales.NoProfile}}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" ToolTip="{x:Static pres:ProjectLocales.LaunchApplication}" Command="{Binding ElementName=StatusViewControl, Path=DataContext.StartApplicationCommand}" CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

        <!-- A chip for an action that just ran -->
        <DataTemplate x:Key="ProfileActionTemplate" DataType="IProfileAction">
            <Border Style="{StaticResource WellBorder}" Margin="0,0,8,8" Padding="12,8" MaxWidth="320">
                <StackPanel>
                    <TextBlock Style="{StaticResource DefaultTextBlock}" FontWeight="SemiBold" Text="{Binding ActionTypeName}" Margin="0"/>
                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding ActionDescription}" ToolTip="{Binding ActionDescription}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360"/>
            <ColumnDefinition Width="2*" MinWidth="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource TitleTextBlock}" Text="{x:Static pres:ProjectLocales.Status}" Margin="8,4,8,12"/>

        <!-- Left column -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Now -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="{StaticResource CardPadding}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="56" Height="56" Style="{StaticResource WellBorder}" VerticalAlignment="Top">
                        <Border Width="48" Height="48" CornerRadius="{StaticResource SmallCornerRadius}">
                            <Border.Background>
                                <ImageBrush Stretch="Uniform" ImageSource="{Binding CurrentApplication.Icon, Converter={StaticResource BitmapToBitmapImageConverter}}"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.CurrentApplication}" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource SubTitleTextBlock}" Text="{Binding CurrentApplication.DisplayName, FallbackValue={x:Static pres:ProjectLocales.NoApplication}}" TextTrimming="CharacterEllipsis" Margin="0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SecondaryTextBlock}" Text="{x:Static pres:ProjectLocales.CurrentProfile}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DefaultTextBlock}" FontWeight="SemiBold" Text="{Binding CurrentProfile.Name, FallbackValue={x:Static pres:ProjectLocales.NoProfile}}" TextTrimming="CharacterEllipsis" Margin="0"/>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top" Padding="10,6" CornerRadius="14" Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource ToggleStatus}" IsChecked="{Binding HDRIsActive, Mode=OneWay}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.HDR}" FontWeight="SemiBold" Margin="8,0,6,0"/>
                            <TextBlock Style="{StaticResource HdrStateText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Last actions -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="{StaticResource CardPadding}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.LastActions}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LastActions}" ItemTemplate="{StaticResource ProfileActionTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextBlock}" Text="—" Margin="0" VerticalAlignment="Top" Visibility="{Binding LastActions.Count, Converter={StaticResource ZeroVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Microphone monitoring: re-read from the hardware whenever the view becomes visible (see code-behind) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="{StaticResource CardPadding}">
                <Grid DataContext="{Binding MicMonitoringStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.MicMonitoring}" Margin="0,0,0,4"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Content="{x:Static pres:ProjectLocales.On}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" ToolTip="{x:Static pres:ProjectLocales.MicMonitoringEnable}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SecondaryTextBlock}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetDescription}" Text="{Binding TargetDescription}" Margin="0"/>
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.MicMonitoringVolume}" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource DefaultTextBlock}" MinWidth="44" TextAlignment="Right" Text="{Binding Volume, StringFormat={}{0:0}%}" Margin="8,0"/>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" ToolTip="{x:Static pres:ProjectLocales.Refresh}" Command="{Binding RefreshCommand}" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right column -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Applications -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="{StaticResource CardPadding}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.Applications}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Settings.ApplicationProfileAssignments}" ItemTemplate="{StaticResource ApplicationTemplate}"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextBlock}" Text="—" Margin="0" VerticalAlignment="Top" Visibility="{Binding Settings.ApplicationProfileAssignments.Count, Converter={StaticResource ZeroVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Action shortcuts -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.ActionShortcuts}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ActionsList" ItemsSource="{Binding Settings.ActionShortcuts}" ItemTemplate="{StaticResource ActionShortcutItemTemplate}"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextBlock}" Text="—" Margin="0" VerticalAlignment="Top" Visibility="{Binding Settings.ActionShortcuts.Count, Converter={StaticResource ZeroVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
