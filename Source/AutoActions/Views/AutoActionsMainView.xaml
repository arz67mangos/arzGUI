<corewpf:MainWindowBase x:Class="AutoActions.Views.AutoActionsMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:corewpf="clr-namespace:CodectoryCore.UI.Wpf;assembly=ArzGUI.Foundation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:AutoActions.Properties"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:pres="clr-namespace:AutoActions.ProjectResources;assembly=AutoActions.ProjectResources"
        xmlns:dsp="clr-namespace:AutoActions.Displays;assembly=AutoActions.Displays"
        xmlns:thm="clr-namespace:AutoActions.Theming"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AutoActions.Views"
        xmlns:root="clr-namespace:AutoActions"
        mc:Ignorable="d"
        Title="{x:Static pres:ProjectLocales.AutoActions}" Name="MainWindow" MinHeight="700" MinWidth="1280" Background="{DynamicResource TransparentBrush}" WindowStyle="None" ResizeMode="CanResize" Closing="Window_Closing" Visibility="{Binding ShowView, Mode=TwoWay, Converter={StaticResource VisibilityBooleanConverter}}"
         Loaded="MainWindow_Loaded" StateChanged="MainWindow_StateChanged" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <!--
        THESIS: arzGUI makes application-state automation readable as a calm sequence, not a dense settings table.
        OWN-WORLD: midnight-to-graphite ground, translucent layered surfaces, coral intent, mint status, soft 10–14px corners.
        STORY: choose a profile, understand each lifecycle lane, then add, edit, or remove an action without ambiguity.
        FIRST VIEWPORT: compact glass sidebar at left; profile list and four action lanes occupy the working canvas; actions stay close to their cards.
        FORM: desktop control surface, chosen profile-columns composition, seed f2d56dc1.
        FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.DataContext>
        <root:AutoActionsDaemon/>
    </Window.DataContext>
    <corewpf:MainWindowBase.DialogService >
        <Binding>
            <Binding.Source>
                <StaticResource ResourceKey="DialogService" />
            </Binding.Source>
        </Binding>
    </corewpf:MainWindowBase.DialogService>
    <Window.Resources>

        <DataTemplate x:Key="AssignmentTemplate" DataType="ApplicationProfileAssignment">
            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=PriorityColumn, Path=ActualWidth}"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource DefaultTextBlock}"  Grid.Column="0" Text="{Binding Position}" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Image Grid.Column="1" Source="{Binding Application.Icon, Converter={StaticResource BitmapToBitmapImageConverter}}" Width="50" Height="50"  Stretch="Fill"></Image>
                    <TextBlock Style="{StaticResource DefaultTextBlock}"  Grid.Column="2" Text="{Binding Application.DisplayName}" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <ComboBox Grid.Column="3" SelectedValuePath="Name" DisplayMemberPath="Name" SelectedValue="{Binding Profile, Mode=TwoWay}" SelectedItem="{Binding Profile, Mode=TwoWay}" ItemsSource="{Binding ElementName=MainWindow , Path=DataContext.Settings.ApplicationProfiles}" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </DataTemplate>

        <!-- "On"/"Off" next to the HDR dot in the sidebar header -->
        <Style x:Key="HdrStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlock}">
            <Setter Property="Text" Value="{x:Static pres:ProjectLocales.Off}"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HDRIsActive}" Value="True">
                    <Setter Property="Text" Value="{x:Static pres:ProjectLocales.On}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    <Grid x:Name="MainGrid" Background="{DynamicResource TransparentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MainGridTranslate"/>
        </Grid.RenderTransform>
        <Border Grid.Row="0" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="/AutoActions.ProjectResources;component/Resources/Logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{x:Static pres:ProjectLocales.AutoActions}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostButton}" FontFamily="{StaticResource IconFont}" Content="&#xE921;" Width="46" Height="38" Padding="0" Margin="0" ToolTip="Minimize" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource GhostButton}" FontFamily="{StaticResource IconFont}" Content="&#xE922;" Width="46" Height="38" Padding="0" Margin="0" ToolTip="Maximize" Click="Maximize_Click"/>
                    <Button Style="{StaticResource GhostButton}" FontFamily="{StaticResource IconFont}" Content="&#xE8BB;" Width="46" Height="38" Padding="0" Margin="0" ToolTip="Close to tray" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation: a TabControl styled as a left sidebar (SidebarTabControl). The header and
             footer blocks are attached content; every tab's page is unchanged. -->
        <TabControl Grid.Row="1" Style="{StaticResource SidebarTabControl}" Padding="8">

            <thm:Sidebar.Header>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/AutoActions.ProjectResources;component/Resources/Logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.AutoActions}" FontSize="17" FontWeight="SemiBold" Margin="0"/>
                            <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding Path=Version, Mode=OneWay, StringFormat=V\{0\}}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,16,0,0" Padding="10,7" CornerRadius="{StaticResource DefaultCornerRadius}" Background="{DynamicResource GlassRaisedBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Style="{StaticResource ToggleStatus}" IsChecked="{Binding HDRIsActive, Mode=OneWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.HDR}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource HdrStateText}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </thm:Sidebar.Header>

            <thm:Sidebar.Footer>
                <StackPanel>
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource GhostButton}" Content="{x:Static pres:ProjectLocales.Info}" Command="{Binding ShowInfoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="{x:Static pres:ProjectLocales.Logs}" Command="{Binding ShowLogsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <Button Style="{StaticResource DangerGhostButton}" Content="{x:Static pres:ProjectLocales.Shutdown}" Command="{Binding ShutdownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>
            </thm:Sidebar.Footer>

            <TabItem Header="{x:Static pres:ProjectLocales.Status}" thm:Sidebar.Icon="&#xE9D9;">
                <local:StatusView DataContext="{Binding}"/>
            </TabItem>
            <TabItem Header="{x:Static pres:ProjectLocales.QuickSettings}" thm:Sidebar.Icon="&#xE9E9;">
                <local:QuickSettingsView DataContext="{Binding QuickSettings}"/>
            </TabItem>
            <TabItem Header="{x:Static pres:ProjectLocales.Profiles}" thm:Sidebar.Icon="&#xE8FD;">
                <local:ProfileManagerView   DataContext="{Binding ElementName=MainWindow , Path=DataContext}"/>
            </TabItem>
            <TabItem Header="{x:Static pres:ProjectLocales.Applications}" thm:Sidebar.Icon="&#xE71D;">
                <Grid x:Name="AssignmentsGrid" Margin="18,16,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"  />

                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"  />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource TitleTextBlock}" Text="{x:Static pres:ProjectLocales.Applications}" Margin="0"/>
                        <TextBlock Style="{StaticResource SecondaryTextBlock}" Text="Assign profiles to applications and control their priority." Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource DefaultBorder}" Grid.ColumnSpan="3" Grid.Row ="1"/>
                    <Grid Grid.IsSharedSizeScope="True" Grid.ColumnSpan="3" Grid.Row ="1" Margin="14">
                        <ListBox Name="ApplicationList" ItemContainerStyle="{StaticResource ListBoxItemStyle }"  ItemsSource="{Binding Settings.ApplicationProfileAssignments}" HorizontalContentAlignment="Stretch" >
                            <ListBox.Template>
                                <ControlTemplate>
                                    <DockPanel LastChildFill="True">

                                        <Grid DockPanel.Dock="Top" Height="Auto" Margin="0,0,0,5" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="IconColumn"/>
                                                <ColumnDefinition SharedSizeGroup="ApplicationColumn"/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CardHeaderTextBlock}" Grid.Column="0" Margin="5,0" Text="{x:Static pres:ProjectLocales.Icon}"/>
                                            <TextBlock Style="{StaticResource CardHeaderTextBlock}" Grid.Column="1" Margin="5,0" Text="{x:Static pres:ProjectLocales.Application}"/>
                                            <TextBlock Style="{StaticResource CardHeaderTextBlock}" Grid.Column="2" Margin="5,0" Text="{x:Static pres:ProjectLocales.Profile}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid Margin="0,5">
                                                <ScrollViewer>
                                                <ItemsPresenter Margin="5"></ItemsPresenter>
                                            </ScrollViewer>
                                                </Grid>
                                        </Grid>

                                    </DockPanel>

                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock/>
                                        <Border Style="{StaticResource DefaultBorder}" Margin="0,4" Padding="10" CornerRadius="10" Background="{DynamicResource GlassSurfaceBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="IconColumn" Width="Auto"/>
                                                <ColumnDefinition SharedSizeGroup="ApplicationColumn" Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                                <Border Width="50" Grid.Column="0"  CornerRadius="{StaticResource DefaultCornerRadius}" Background="{DynamicResource IconBackgroundBrush}">
                                                <Border  Height="49" Width="49" CornerRadius="{StaticResource DefaultCornerRadius}" Margin="1">
                                                    <Border.Background>
                                                        <ImageBrush Stretch="Fill" ImageSource="{Binding Application.Icon, Converter={StaticResource BitmapToBitmapImageConverter}}"/>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <TextBlock Style="{StaticResource DefaultTextBlock}"  Grid.Column="1" Width="Auto"  Padding="5,0" Text="{Binding Application.DisplayName}" VerticalAlignment="Center" HorizontalAlignment="Stretch"  />
                                            <ComboBox MinHeight="35" VerticalContentAlignment="Stretch" Grid.Column="2" Width="Auto"  Margin="5,0,10,0"  SelectedItem="{Binding Profile}" ItemTemplate="{StaticResource ProfileItemTemplate}" ItemsSource="{Binding ElementName=MainWindow , Path=DataContext.Settings.ApplicationProfiles}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Height="Auto" Margin="0,10,0,0" VerticalAlignment="Bottom" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="6" Width="Auto" IsEnabled="{Binding ElementName=ApplicationList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}"  Height="Auto" Content="{x:Static pres:ProjectLocales.LaunchApplication}" Command="{Binding StartApplicationCommand}" CommandParameter="{Binding ElementName=ApplicationList, Path=SelectedItem}"  Margin="5,5,10,10"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFont}" Command="{Binding AddAssignmentCommand}" Content="&#xE710;" ToolTip="Add application" Margin="0,0,5,0"/>
                        <Button Grid.Column="2" Style="{StaticResource ActionDeleteButton}" FontFamily="{StaticResource IconFont}" Command="{Binding RemoveAssignmentCommand}" CommandParameter="{Binding ElementName=ApplicationList, Path=SelectedItem}" Content="&#xE74D;" ToolTip="Remove application" IsEnabled="{Binding ElementName=ApplicationList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}" Margin="5,0"/>

                        <Button Grid.Column="3" Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFont}" Command="{Binding EditApplicationCommand}" Content="&#xE712;" ToolTip="Edit application" CommandParameter="{Binding ElementName=ApplicationList, Path=SelectedItem}" IsEnabled="{Binding ElementName=ApplicationList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}" Margin="5,0"/>

                        <Button Grid.Column="4" Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFont}" Command="{Binding MoveAssignmentUpCommand}" Content="&#xE70E;" ToolTip="Move up" CommandParameter="{Binding ElementName=ApplicationList, Path=SelectedItem}" Margin="5,0" IsEnabled="{Binding ElementName=ApplicationList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}"/>
                        <Button Grid.Column="5" Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFont}" Command="{Binding MoveAssignmentDownCommand}" Content="&#xE70D;" ToolTip="Move down" CommandParameter="{Binding ElementName=ApplicationList, Path=SelectedItem}" IsEnabled="{Binding ElementName=ApplicationList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}" Margin="5,0"/>


                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static pres:ProjectLocales.Displays}" thm:Sidebar.Icon="&#xE7F4;">
                <local:MonitorManagerView   DataContext="{x:Static dsp:DisplayManagerHandler.Instance}"  IsEnabled="{Binding Settings.GlobalAutoActions, Converter={StaticResource InvertBooleanConverter}}"/>
            </TabItem>

            <TabItem Header="{x:Static pres:ProjectLocales.Settings}" thm:Sidebar.Icon="&#xE713;">

                    <Grid  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <local:UserAppSettingsView     DataContext="{Binding ElementName=MainWindow , Path=DataContext.Settings}" />
                        </ScrollViewer>

                    </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</corewpf:MainWindowBase>
