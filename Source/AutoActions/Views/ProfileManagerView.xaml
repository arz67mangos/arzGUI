<corewpf:UserControlBase x:Class="AutoActions.Views.ProfileManagerView" x:Name="ProfileManager"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:corewpf="clr-namespace:CodectoryCore.UI.Wpf;assembly=ArzGUI.Foundation" xmlns:root="clr-namespace:AutoActions"
 xmlns:actions="clr-namespace:AutoActions.Profiles.Actions" xmlns:pres="clr-namespace:AutoActions.ProjectResources;assembly=AutoActions.ProjectResources"
 mc:Ignorable="d" d:DataContext="{d:DesignInstance root:AutoActionsDaemon, IsDesignTimeCreatable=false}" d:DesignHeight="720" d:DesignWidth="1120">
 <corewpf:UserControlBase.DialogService><Binding Source="{StaticResource ProfileDialogService}"/></corewpf:UserControlBase.DialogService>
 <UserControl.Resources>
  <DataTemplate DataType="{x:Type actions:DisplayAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:DisplayColorAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE790;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:AudioDeviceAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:MicMonitoringAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE720;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:RunProgramAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:CloseProgramAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:MonitorDeviceAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F8;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:ReferenceProfileAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;"/></DataTemplate>
  <DataTemplate DataType="{x:Type actions:ObsStudioAction}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE714;"/></DataTemplate>
  <DataTemplate x:Key="ProfileActionItemTemplate">
   <Border Height="66" Margin="0,4" Padding="10,7" CornerRadius="{StaticResource SmallCornerRadius}" Background="{DynamicResource GlassRaisedBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <ContentControl Content="{Binding}" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,8,0"><TextBlock Style="{StaticResource DefaultTextBlock}" Text="{Binding ActionTypeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0"/><TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding ActionDescription}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionDescription}" Margin="0,3,0,0"/></StackPanel>
     <Button Grid.Column="2" Style="{StaticResource ActionIconButton}" Content="&#xE712;" ToolTip="Edit action" AutomationProperties.Name="Edit action" Command="{Binding ElementName=ProfileList, Path=SelectedItem.EditProfileActionCommand}" CommandParameter="{Binding}"/>
     <Button Grid.Column="3" Style="{StaticResource ActionDeleteButton}" Content="&#xE711;" ToolTip="Remove action" AutomationProperties.Name="Remove action" Command="{Binding ElementName=ProfileList, Path=SelectedItem.RemoveProfileActionCommand}" CommandParameter="{Binding}"/>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="ProfileItemTemplate"><Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource DefaultTextBlock}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0"/><TextBlock Style="{StaticResource CaptionTextBlock}" Text="Automation profile" Margin="0,2,0,0"/></StackPanel>
  </Grid></DataTemplate>
  <Style x:Key="LaneBorder" TargetType="Border" BasedOn="{StaticResource DefaultBorder}"><Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 </UserControl.Resources>
 <Grid Margin="18,16,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Style="{StaticResource TitleTextBlock}" Text="{x:Static pres:ProjectLocales.Profiles}" Margin="0"/><TextBlock Style="{StaticResource SecondaryTextBlock}" Text="Create and manage automation profiles for your PC." Margin="0,4,0,0"/></StackPanel>
   <Button Grid.Column="1" Command="{Binding AddProfileCommand}" Margin="12,0,0,0" Padding="15,9"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,8,0"/><TextBlock Text="New profile"/></StackPanel></Button>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DefaultBorder}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.Profiles}" Margin="6,4,6,8"/>
    <ListBox Grid.Row="1" x:Name="ProfileList" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource ProfileItemTemplate}" ItemContainerStyle="{StaticResource ListBoxItemStyle}" ItemsSource="{Binding Settings.ApplicationProfiles}" Background="{DynamicResource TransparentBrush}" BorderThickness="0"/>
    <Button Grid.Row="2" Style="{StaticResource DangerGhostButton}" Command="{Binding RemoveProfileCommand}" CommandParameter="{Binding ElementName=ProfileList, Path=SelectedItem}" IsEnabled="{Binding ElementName=ProfileList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}" Margin="4,8,4,4"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,0,7,0"/><TextBlock Text="Remove profile"/></StackPanel></Button>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource DefaultBorder}" Padding="14" DataContext="{Binding ElementName=ProfileList, Path=SelectedItem}" Visibility="{Binding ElementName=ProfileList, Path=SelectedItem, Converter={StaticResource NotNullVisibilityConverter}}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource CaptionTextBlock}" Text="{x:Static pres:ProjectLocales.CurrentProfile}" Margin="0"/><TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding RestartApplication, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock Text="{x:Static pres:ProjectLocales.RestartProccessOnFirstOccurence}" TextWrapping="Wrap" MaxWidth="150"/></CheckBox></Grid>
     <TextBlock Grid.Row="1" Style="{StaticResource CardHeaderTextBlock}" Text="{x:Static pres:ProjectLocales.Actions}" Margin="2,0,2,8"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource LaneBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SuccessBrush}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0"><TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.AppStartedActions}" FontWeight="SemiBold" Margin="0"/><TextBlock Style="{StaticResource CaptionTextBlock}" Text="Runs when an assigned application starts." Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddStartedActionCommand}" Content="+  Add action"/><ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ApplicationStarted}" ItemTemplate="{StaticResource ProfileActionItemTemplate}" Margin="0,7,0,0"/></Grid></Border>
      <Border Style="{StaticResource LaneBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource DangerBrush}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0"><TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.AppClosedActions}" FontWeight="SemiBold" Margin="0"/><TextBlock Style="{StaticResource CaptionTextBlock}" Text="Runs when the application closes." Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddClosedActionCommand}" Content="+  Add action"/><ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ApplicationClosed}" ItemTemplate="{StaticResource ProfileActionItemTemplate}" Margin="0,7,0,0"/></Grid></Border>
      <Border Style="{StaticResource LaneBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81E;" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0"><TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.AppFocusedActions}" FontWeight="SemiBold" Margin="0"/><TextBlock Style="{StaticResource CaptionTextBlock}" Text="Runs when the application receives focus." Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddGotFocusActionCommand}" Content="+  Add action"/><ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ApplicationGotFocus}" ItemTemplate="{StaticResource ProfileActionItemTemplate}" Margin="0,7,0,0"/></Grid></Border>
      <Border Style="{StaticResource LaneBorder}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource WarningBrush}"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE769;" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0"><TextBlock Style="{StaticResource DefaultTextBlock}" Text="{x:Static pres:ProjectLocales.AppLostFocusActions}" FontWeight="SemiBold" Margin="0"/><TextBlock Style="{StaticResource CaptionTextBlock}" Text="Runs when focus moves to another application." Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddLostFocusActionCommand}" Content="+  Add action"/><ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ApplicationLostFocus}" ItemTemplate="{StaticResource ProfileActionItemTemplate}" Margin="0,7,0,0"/></Grid></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</corewpf:UserControlBase>
