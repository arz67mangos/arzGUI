<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens (light values). Theming/0_LightColors.xaml and Theming/0_DarkColors.xaml
        define exactly the same keys and are merged AFTER AppResources.xaml at runtime by
        ThemeManager, so they win. Everything that should follow the theme must reference the
        *Brush keys with DynamicResource. This file exists so every StaticResource lookup inside
        the merged dictionaries (BasedOn, Color="{StaticResource ...}") resolves at parse time.
    -->

    <!-- Surfaces -->
    <Color x:Key="SurfaceColor">#F4F5F7</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSunkenColor">#E9EBEF</Color>
    <Color x:Key="BackdropStartColor">#EFF6FF</Color>
    <Color x:Key="BackdropMidColor">#E7F0FC</Color>
    <Color x:Key="BackdropEndColor">#DCE8F6</Color>
    <Color x:Key="GlassSurfaceColor">#A8F7FAFF</Color>
    <Color x:Key="GlassRaisedColor">#D6FFFFFF</Color>
    <Color x:Key="GlassStrokeColor">#663C5E82</Color>
    <Color x:Key="AcrylicTintColor">#66F2F6FB</Color>
    <Color x:Key="TransparentColor">#00000000</Color>
    <Color x:Key="ShadowColor">#280B2038</Color>

    <!-- Borders -->
    <Color x:Key="StrokeColor">#DFE3E8</Color>
    <Color x:Key="StrokeStrongColor">#C3C9D1</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1B1F24</Color>
    <Color x:Key="TextSecondaryColor">#5F6873</Color>
    <Color x:Key="TextDisabledColor">#A3AAB3</Color>

    <!-- Accent (coral, as upstream) -->
    <Color x:Key="AccentColor">#EE5A5A</Color>
    <Color x:Key="AccentHoverColor">#F27373</Color>
    <Color x:Key="AccentPressedColor">#D74848</Color>
    <Color x:Key="AccentSoftColor">#FCE4E4</Color>
    <Color x:Key="AccentForegroundColor">#1B1F24</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#22B577</Color>
    <Color x:Key="SuccessTextColor">#087F5B</Color>
    <Color x:Key="WarningColor">#E9A23B</Color>
    <Color x:Key="DangerColor">#C73535</Color>

    <!-- Controls -->
    <Color x:Key="ControlColor">#FFFFFF</Color>
    <Color x:Key="ControlHoverColor">#EEF0F3</Color>
    <Color x:Key="ControlPressedColor">#E2E5EA</Color>
    <Color x:Key="ControlDisabledColor">#EDEFF2</Color>

    <!-- Scrollbars -->
    <Color x:Key="ScrollThumbColor">#C3C9D1</Color>
    <Color x:Key="ScrollThumbHoverColor">#A8B0BA</Color>
    <Color x:Key="ScrollThumbActiveColor">#8C95A1</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}"/>
    <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackdropStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BackdropMidColor}" Offset="0.52"/>
        <GradientStop Color="{StaticResource BackdropEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource GlassSurfaceColor}"/>
    <SolidColorBrush x:Key="GlassRaisedBrush" Color="{StaticResource GlassRaisedColor}"/>
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{StaticResource GlassStrokeColor}"/>
    <SolidColorBrush x:Key="AcrylicTintBrush" Color="{StaticResource AcrylicTintColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="{StaticResource ControlDisabledColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{StaticResource ScrollThumbActiveColor}"/>

    <!--
        Legacy keys. Other dictionaries and views still reference these by name; they now alias
        the tokens above. Keep them in sync with the two theme files.
    -->
    <Color x:Key="ActiveColor">#22B577</Color>
    <Color x:Key="ControlMouseOverColor">#F27373</Color>
    <Color x:Key="WindowColor">#F4F5F7</Color>
    <Color x:Key="SelectedBackgroundColor">#FCE4E4</Color>
    <Color x:Key="SelectedUnfocusedColor">#E2E5EA</Color>
    <Color x:Key="ControlLightColor">#FFFFFF</Color>
    <Color x:Key="ControlMediumColor">#C3C9D1</Color>
    <Color x:Key="IconBackgroundColor">#E9EBEF</Color>
    <Color x:Key="GlyphColor">#5F6873</Color>
    <Color x:Key="DisabledForegroundColor">#A3AAB3</Color>
    <Color x:Key="DisabledControlDarkColor">#EDEFF2</Color>
    <Color x:Key="DisabledBorderColor">#DFE3E8</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ActiveBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="HighlightedBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="HighlightedInactiveAccentBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="MouseOverBrush" Color="{StaticResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlLightBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="{StaticResource SurfaceSunkenColor}"/>
    <SolidColorBrush x:Key="InactiveAccentBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="DisabledAccentBrush" Color="{StaticResource ControlDisabledColor}"/>
    <SolidColorBrush x:Key="DragScrollBrush" Color="{StaticResource ScrollThumbActiveColor}"/>
    <SolidColorBrush x:Key="ScrollBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="MouseOverScrollBrush" Color="{StaticResource ScrollThumbHoverColor}"/>

</ResourceDictionary>
